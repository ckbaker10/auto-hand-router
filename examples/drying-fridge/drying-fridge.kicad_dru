(version 1)

# Conservative JLCPCB 2-layer / 1oz profile.
# Source checked 2026-10-27: https://jlcpcb.com/capabilities/pcb-
# Overall clearance, drill, edge and legend limits are stored in .kicad_pro.
(rule "JLCPCB recommended PTH annular ring 1oz"
 (condition "A.Type == 'Pad' && A.isPlated()")
 (constraint annular_width (min 0.25mm)))

(rule "Carrier NPTH minimum diameter"
 (condition "A.Type == 'Pad' && !A.isPlated()")
 (constraint hole_size (min 0.5mm)))
