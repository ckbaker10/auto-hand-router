    (effects
      (font
        (size 1.8 1.8)
      )
      (justify left)
    )
    (uuid 9bb76789-28af-4da1-a31b-699d2f17a7f1)
  )
  (text "SPI direkt wie getesteter Aufbau: keine externen Pull-ups an CS, SDI oder SDO."
