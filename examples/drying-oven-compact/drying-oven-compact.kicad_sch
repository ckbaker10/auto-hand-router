    (effects
      (font
        (size 1.1 1.1)
      )
      (justify left)
    )
    (uuid d97ec88c-7548-46d1-a1f3-26f8e2dd91ab)
  )
  (text "Getrennte 3V3-Regler: MCU_3V3 und +3V3_EXT NICHT verbinden."
